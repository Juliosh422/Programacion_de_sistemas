<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/editText_input"
        android:hint="@string/edit_text_hint"
         />
    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/but_share"
        android:text="@string/but_share_string"
        />
    <Button
        android:id="@+id/but_continue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/but_continue_string" />

    <Button
        android:id="@+id/but_reaction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/but_reaction_string" />

    <TextView
        android:id="@+id/tv_reaction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

</LinearLayout>